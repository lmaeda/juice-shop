# .env_snyk_ub — credentials + URLs for the Snyk Universal Broker registry evaluation.
#
# TEMPLATE. Copy to .env_snyk_ub and fill in. The real file is gitignored.
#
#
# Consumed by the examples in lmaeda/snyk-ub-artifactory-nexus and by the
# snyk-ub-eval/ directory on branch snyk-ub-eval-2026-08-06 of the three app repos.
#
#   set -a; . ./.env_snyk_ub; set +a      # export into the current shell
# Prefer a subshell so the values do not linger:
#   ( set -a; . ./.env_snyk_ub; set +a; <command> )

# --- Snyk -------------------------------------------------------------------
SNYK_ORG_SLUG=
SNYK_ORG_ID=

# --- Nexus Repository 3 (host side; container port is 8081) ------------------
NEXUS_BASE_URL=
NEXUS_USER=
NEXUS_PASSWORD=
NEXUS_PASSWORD_URLENCODED=
NEXUS_AUTH_BASE64=
NEXUS_NPM_REGISTRY=
NEXUS_MAVEN_URL=
NEXUS_GOPROXY=

# --- JFrog Artifactory OSS ---------------------------------------------------
ARTIFACTORY_BASE_URL=
ARTIFACTORY_USER=
ARTIFACTORY_PASSWORD=
ARTIFACTORY_MAVEN_URL=
# Go via Artifactory is NOT usable: OSS offers no Go package type, and the go
# client refuses credentials over plain HTTP (GOINSECURE does not override it).
ARTIFACTORY_GOPROXY=

# ---------------------------------------------------------------------------
# Notes
#   NEXUS_PASSWORD_URLENCODED  percent-encode @ as %40 (needed inside a URL)
#   NEXUS_AUTH_BASE64          derive, do not hand-write:
#                                printf 'admin:%s' "$NEXUS_PASSWORD" | base64
#   ARTIFACTORY_GOPROXY        leave EMPTY. Artifactory OSS has no Go package
#                              type, and the go client refuses credentials over
#                              plain HTTP; GOINSECURE does not override that.
# ---------------------------------------------------------------------------
